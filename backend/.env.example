# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# ".env" NIEMALS in Git/GitHub hochladen (siehe .gitignore).

# Origin, von der dein Frontend läuft (für CORS)
FRONTEND_ORIGIN=http://localhost:5500

# Optionaler API-Key für eine echte Game-Datenbank (z. B. RAWG.io)
GAME_API_KEY=

# "true" nur für lokale Entwicklung, niemals in Produktion
FLASK_DEBUG=false
